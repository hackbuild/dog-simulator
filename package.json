{
  "name": "dog-simulator-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "workspaces": [
    "packages/*",
    "vendor/*"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "if ls packages/*/package.json >/dev/null 2>&1; then npm run build -w ./packages/* --if-present; else echo \"build: no app packages yet\"; fi",
    "test": "vitest run --passWithNoTests && node --test tools/test/*.test.mjs",
    "typecheck": "tsc -b",
    "lint:voice": "git ls-files | grep -Ev '\\.(png|jpe?g|glb|bin|wasm|wav)$|^(vendor/|LICENSES/|RULES.md|CLAUDE.md|tools/|legacy/)|package-lock.json|Cargo.lock' | xargs node tools/lint-voice.mjs",
    "build:legacy": "node tools/build-html.mjs legacy",
    "lock": "node tools/lock-assets.mjs",
    "lock:check": "node tools/lock-assets.mjs --check",
    "build:det": "node tools/build-html.mjs legacy --mods legacy/det/src --out dist/hackle-det.html",
    "build:app": "node tools/build-html.mjs app",
    "build:public": "node tools/build-html.mjs public",
    "build:stub": "node tools/build-html.mjs stub",
    "check:boot": "node tools/runner/boot.mjs",
    "check:train": "node tools/runner/train.mjs",
    "check:setup": "node tools/runner/setup.mjs",
    "check:speed": "node tools/runner/speed.mjs",
    "check:determinism": "node tools/runner/determinism.mjs dist/hackle-det.html --seconds 600",
    "scenarios": "node scenarios/run.mjs",
    "vendor:check": "node tools/vendor-libs.mjs --check",
    "ui:check": "node tools/vendor/pin-ui.mjs --check",
    "build:site": "node tools/build-site.mjs"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@hackbuild/scenario": "0.1.0",
    "@types/three": "0.187.0",
    "@virgilvox/hackbuild-ui": "file:tools/vendor/hackbuild-ui-0.10.6-c7f5ed1.tgz",
    "esbuild": "0.28.2",
    "onnxruntime-web": "1.23.2",
    "puppeteer-core": "25.18.1",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@hackbuild/agents-views": "0.2.0",
    "@hackbuild/cameras": "0.1.0",
    "@hackbuild/drives": "0.1.0",
    "@hackbuild/gait": "0.1.0",
    "@hackbuild/motion-net": "0.2.0",
    "@hackbuild/senses": "0.1.0",
    "@hackbuild/tunables": "0.1.0",
    "@hackbuild/weights": "0.1.0"
  }
}
