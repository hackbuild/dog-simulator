{
  "name": "@hackbuild/motion-net",
  "version": "0.1.0",
  "description": "A runtime for small motion networks (dense stacks, codebook matching) on WebGPU or wasm SIMD in a worker, and a quadruped gait host over the published codebook network. Ships no weights.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-motion.git",
    "directory": "packages/motion-net"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inline": {
      "types": "./dist/wasm/inline.d.ts",
      "import": "./dist/wasm/inline.js"
    },
    "./wasm": "./dist/wasm/motion_net_bg.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@hackbuild/gait": "0.1.0"
  }
}
